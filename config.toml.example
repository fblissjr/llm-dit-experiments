# llm-dit-experiments configuration template
# last updated: 2026-02-15
#
# Copy to config.toml and edit paths for your setup:
#   cp config.toml.example config.toml
#
# CLI flags override config values. Run: uv run web/server.py --help
#
# Quantization methods (used across all pipelines):
#   none             BF16 weights, no compression
#   fp8-weight-only  FP8 weights, BF16 compute (compile-safe, recommended)
#   fp8-dynamic      FP8 weights + activations (fastest, NOT compile-safe)
#   int8             INT8 weight-only (any GPU)
#   int4             INT4 weight-only (max compression)


# -- Startup ----------------------------------------------------------------

# Which pipeline to preload: none, z-image, qwen-image, flux2, ltx2
default_pipeline = "none"
templates_dir = "templates/z_image"


# -- Quantization (global defaults) ----------------------------------------
# Pipeline sections can override per-component.

[quantization]
encoder = "none"
transformer = "fp8-weight-only"
vae = "none"
granularity = "per-tensor"      # per-tensor, per-row (FP8 only)


# -- Shared text encoder (Z-Image / Qwen-Image) ----------------------------

[encoder]
device = "cuda"
dtype = "bfloat16"
quantization = "none"
hidden_layer = -2               # Z-Image training default


# -- Shared generation defaults ---------------------------------------------

[pipeline]
device = "auto"
dtype = "bfloat16"
enable_model_cpu_offload = false
enable_sequential_cpu_offload = false

[generation]
height = 1024
width = 1024
enable_thinking = true
default_template = ""
cfg_truncation = 1.0
cfg_norm_mode = "clamp"

[scheduler]
dynamic_shift = true


# -- Optimization -----------------------------------------------------------

[optimization]
compile = true                  # ~10% speedup after warmup; INCOMPATIBLE with CPU offload
# Compile mode: default, max-autotune-no-cudagraphs, reduce-overhead
compile_mode = "default"

[pytorch]
# Attention backend: auto, flash_attn_3, flash_attn_2, sage, xformers, sdpa
attention_backend = "auto"
use_custom_scheduler = true
tiled_vae = false
tile_size = 512
tile_overlap = 64
embedding_cache = true
cache_size = 100
# Long prompt handling: truncate, interpolate, pool, attention_pool
long_prompt_mode = "interpolate"

[lora]
paths = []
scales = []


# ==========================================================================
# Pipeline: Z-Image
# ==========================================================================
# Variants: turbo (9 steps, no CFG), base (35 steps, CFG=4.0), auto

[zimage]
# model_path = "/path/to/Z-Image-Turbo"
variant = "turbo"


# ==========================================================================
# Pipeline: FLUX.2 Klein
# ==========================================================================
# 4B/9B image generation. Encoder: Qwen3-8B.

[flux2]
# model_path = "/path/to/FLUX.2-klein-9b-fp8"
# vae_path = "/path/to/FLUX.2-klein-9B"
# encoder_path = "/path/to/Qwen3-8B"

# Model variant (sets default steps + guidance automatically):
#   Distilled (4 steps, guidance=1.0): klein-4b, klein-9b, klein-4b-fp8, klein-9b-fp8
#   Base (50 steps, guidance=4.0):     klein-base-4b, klein-base-9b, klein-base-4b-fp8, klein-base-9b-fp8
default_model = "klein-9b-fp8"

# Override model defaults (None/omit = use model default from table above)
default_steps = 4
default_guidance = 1.0

encoder_device = "cuda"         # cuda (recommended), cpu
offload_between_stages = true   # three-stage offload: encoder -> transformer -> VAE (saves ~5GB)
block_offload = false           # INCOMPATIBLE with quantization + compile

# Quantization: none, fp8-weight-only, fp8-dynamic, int8, int4
quantization = "fp8-weight-only"

compile = false                 # marginal ROI for 4-step distilled (see docs/guides/compile_and_resolution.md)
compile_vae = false             # marginal ROI (89s warmup, ~0.5s savings/decode)
# Compile mode: default, max-autotune-no-cudagraphs, reduce-overhead
compile_mode = "default"


# ==========================================================================
# Pipeline: LTX-2 (video + audio)
# ==========================================================================
# 19B model (14B video + 5B audio). Encoder: Gemma 3-12B.
# RTX 4090: use FP8 + model-level offloading.

[ltx2]
# model_path = "/path/to/LTX-2"
transformer_file = "ltx-2-19b-distilled-fp8.safetensors"

# Two-stage pipeline files
spatial_upsampler_file = "ltx-2-spatial-upscaler-x2-1.0.safetensors"
distilled_lora_path = ""        # distilled LoRA for stage 2 refinement
distilled_lora_scale = 0.8

# Gemma 3-12B encoder
# Leave empty for bf16/8bit (uses model_path/text_encoder). Set to HF model ID for q4-qat variant.
encoder_model_id = ""

# LoRA
lora_path = ""
lora_scale = 1.0                # blend scale (0.0-1.0)

# Offload mode: none (>48GB), model (~20-50% slower), sequential (~3-5x slower), group (configurable)
offload_mode = "model"
num_blocks_per_group = 2        # group mode only: DiT blocks to keep on GPU

# Video defaults
height = 512
width = 768
num_frames = 33
fps = 24
num_inference_steps = 12
guidance_scale = 3.0

# Audio
audio_enabled = false
audio_negative_prompt = ""

# Two-stage pipeline (reference: TI2VidTwoStagesPipeline)
use_two_stage = true
stage1_num_inference_steps = 40
stage2_num_inference_steps = 3
negative_prompt = "blurry, out of focus, overexposed, underexposed, low contrast, washed out colors, excessive noise, grainy texture, poor lighting, flickering, motion blur, distorted proportions, unnatural skin tones, deformed facial features, asymmetrical face, missing facial features, extra limbs, disfigured hands, wrong hand count, artifacts around text, inconsistent perspective, camera shake, incorrect depth of field, background too sharp, background clutter, distracting reflections, harsh shadows, inconsistent lighting direction, color banding, cartoonish rendering, 3D CGI look, unrealistic materials, uncanny valley effect, incorrect ethnicity, wrong gender, exaggerated expressions, wrong gaze direction, mismatched lip sync, silent or muted audio, distorted voice, robotic voice, echo, background noise, off-sync audio, incorrect dialogue, added dialogue, repetitive speech, jittery movement, awkward pauses, incorrect timing, unnatural transitions, inconsistent framing, tilted camera, flat lighting, inconsistent tone, cinematic oversaturation, stylized filters, or AI artifacts."

# Guidance (stage 1 only)
stg_scale = 0.0                 # spatio-temporal guidance (0=disabled)
stg_blocks = "29"               # comma-separated block indices for STG
rescale_scale = 0.7             # CFG rescaling to prevent over-saturation

# Optimization
ge_gamma = 0.0                  # gradient estimation gamma (0=disabled, 2.0=reference)

# Legacy single-stage distilled mode
use_distilled = true
distilled_steps_stage1 = 8
distilled_steps_stage2 = 4

# Image-to-video
input_image = ""
image_weight = 0.7

# Tiled VAE (required for video decode on 24GB)
tiled_vae = true
tile_size_temporal = 8
tile_size_spatial = 256
tile_overlap_temporal = 4
tile_overlap_spatial = 32

# Output
output_path = "output.mp4"

# Device placement
text_encoder_device = "cuda"    # cuda recommended (encoder loads to CUDA for encoding)
transformer_device = "cuda"
vae_device = "cuda"

# Transformer quantization: none, fp8 (alias for fp8-weight-only), fp8-dynamic, int8, int4
quantize = "fp8"
skip_cleanup = false
gemma_variant = "8bit"          # gemma3 backbone: bf16, 8bit, q4-qat


# ==========================================================================
# Pipeline: Qwen-Image
# ==========================================================================
# Variants: qwenimage-t2i (60-layer DiT), qwenimage-edit (8B),
#           qwenimage-layered (decomposition).
# Encoder: Qwen2.5-VL-7B.

[qwen_image]
# model_path = "/path/to/Qwen-Image-2512"
cpu_offload = true
cfg_scale = 4.0
quantize_text_encoder = "none"
quantize_transformer = "none"


# ==========================================================================
# Features (Z-Image specific)
# ==========================================================================

[dype]
# Dynamic Position Extrapolation for 2K-4K+ resolution
enabled = false
method = "vision_yarn"
dype_scale = 2.0
dype_exponent = 2.0
dype_start_sigma = 1.0
base_shift = 0.5
max_shift = 1.15
base_resolution = 1024
anisotropic = false
multipass = "single"
pass2_strength = 0.5
pass3_strength = 0.4
frequency_modulation = false

[slg]
# Skip Layer Guidance for improved structure/anatomy (~2x inference time)
enabled = false
scale = 2.5
layers = [7, 8, 9, 10, 11, 12]
start = 0.05
stop = 0.5

[fmtt]
# Flow Map Trajectory Tilting: SigLIP2-guided reward optimization
enabled = false
guidance_scale = 1.0
guidance_start = 0.0
guidance_stop = 0.5
normalize_mode = "unit"
decode_scale = 0.5
siglip_model = "google/siglip2-giant-opt-patch16-384"
siglip_device = "cpu"


# ==========================================================================
# Remote API / Rewriter
# ==========================================================================

[api]
url = ""                        # Remote encoder API (empty = local)
model = "Qwen3-4B"

[rewriter]
use_api = false
api_url = ""
api_model = "Qwen3-4B"
temperature = 0.6
top_p = 0.95
top_k = 20
min_p = 0.0
presence_penalty = 0.0
max_tokens = 1024
timeout = 120.0


# ==========================================================================
# Server
# ==========================================================================

[server]
host = "127.0.0.1"
port = 7860

[logging]
enabled = true
log_dir = "logs"
log_level = "INFO"
max_bytes = 10485760
backup_count = 5
log_requests = true
log_generation_params = true
