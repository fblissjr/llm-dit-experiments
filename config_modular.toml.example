# Modular Configuration for llm-dit-experiments
#
# last updated: 2025-12-31
#
# This config format eliminates redundancy by:
# 1. Defining components once in a library
# 2. Referencing components by ID in model definitions
# 3. Supporting inheritance between model types
# 4. Separating hardware profiles from model configs
#
# Usage:
#   uv run scripts/generate.py --config config.toml --config-name rtx4090_zimage "A cat"
#   uv run web/server.py --config config.toml --config-name rtx4090_qwenimageedit_compiled

# =============================================================================
# HARDWARE PROFILES
# Define device placement and hardware-specific optimizations
# =============================================================================

[profiles.default]
description = "Default profile - auto-detect GPU"
dtype = "bfloat16"
attention_backend = "auto"
compile = false
compile_mode = "default"  # CPU-offload safe (no CUDA graphs)
use_custom_scheduler = true

[profiles.default.devices]
encoder = "auto"
dit = "auto"
vae = "auto"
siglip = "cpu"

[profiles.rtx4090]
description = "RTX 4090 24GB - optimized settings"
dtype = "bfloat16"
attention_backend = "auto"  # Let diffusers auto-detect best backend
compile = false
compile_mode = "default"  # CPU-offload safe (no CUDA graphs)
tiled_vae = false
tile_size = 512
tile_overlap = 64
embedding_cache = true
cache_size = 100
long_prompt_mode = "interpolate"
use_custom_scheduler = true

[profiles.rtx4090.devices]
encoder = "cuda"
dit = "cuda"
vae = "cuda"
siglip = "cpu"

[profiles.rtx3090]
description = "RTX 3090 24GB - conservative settings"
dtype = "float16"  # 3090 has slower bfloat16
attention_backend = "sdpa"
compile = false
compile_mode = "reduce-overhead"
tiled_vae = true  # More conservative memory
tile_size = 256
tile_overlap = 32

[profiles.rtx3090.devices]
encoder = "cuda"
dit = "cuda"
vae = "cuda"

[profiles.cpu_only]
description = "CPU-only inference (slow but universal)"
dtype = "float32"
attention_backend = "sdpa"
compile = false

[profiles.cpu_only.devices]
encoder = "cpu"
dit = "cpu"
vae = "cpu"

# =============================================================================
# COMPONENT LIBRARY
# Define reusable components referenced by model types
# =============================================================================

[encoders.qwen3_4b]
description = "Qwen3-4B for Z-Image text encoding"
model_id = "Qwen/Qwen3-4B"
hidden_dim = 2560
num_layers = 36
default_hidden_layer = -2
max_tokens = 1504
quantization_options = ["none", "4bit", "8bit"]
# Layer blending supported - see [layer_blend_presets] section below
# CLI: --layer-weights "-2:0.7,-6:0.3"

[encoders.qwen2_5_vl_7b]
description = "Qwen2.5-VL-7B for Qwen-Image pipelines"
model_id = "Qwen/Qwen2.5-VL-7B-Instruct"
hidden_dim = 3584
num_layers = 28
default_hidden_layer = -2
max_tokens = 2048
quantization_options = ["none", "4bit", "8bit", "fp8", "int8"]

[transformers.zimage_dit]
description = "Z-Image DiT transformer (turbo distilled)"
num_layers = 40
latent_channels = 16
quantization_options = ["none"]  # No quantization for Z-Image DiT

[transformers.qwenimage_dit]
description = "Qwen-Image DiT transformer (20.43B parameters)"
num_layers = 30
latent_channels = 16
quantization_options = ["none", "4bit", "8bit", "fp8", "int8"]

[transformers.qwenimage2512_dit]
description = "Qwen-Image-2512 DiT transformer (60 layers, 39GB)"
num_layers = 60
latent_channels = 16
hidden_dim = 3840
num_heads = 24
quantization_options = ["fp8", "int8", "4bit", "8bit"]  # FP8 required for 24GB GPUs

[vaes.zimage_vae]
description = "Z-Image VAE (16 channel latents)"
latent_scaling = 0.13025
latent_channels = 16

[vaes.qwenimage_vae]
description = "Qwen-Image VAE"
latent_scaling = 0.13025
latent_channels = 16

[schedulers.flow_turbo]
description = "Flow matching scheduler for turbo models"
type = "flow_matching"
shift = 3.0
shift_mode = "fixed"

[schedulers.flow_standard]
description = "Flow matching scheduler for non-turbo models"
type = "flow_matching"
shift = 3.0
shift_mode = "dynamic"

# =============================================================================
# MODEL TYPES
# Define pipelines with component references and defaults
# =============================================================================

[models.zimage]
description = "Z-Image (Alibaba/Tongyi) - turbo distilled text-to-image"
pipeline_class = "ZImagePipeline"
text_encoder = "qwen3_4b"
dit = "zimage_dit"
vae = "zimage_vae"
scheduler = "flow_turbo"
model_path = "/path/to/Z-Image"
templates_dir = "templates/z_image"
default_steps = 9
default_cfg_scale = 0.0
default_resolution = 1024

[models.qwenlayered]
description = "Qwen-Image-Layered - multi-layer decomposition generation"
pipeline_class = "QwenImageDiffusersPipeline"
text_encoder = "qwen2_5_vl_7b"
dit = "qwenimage_dit"
vae = "qwenimage_vae"
scheduler = "flow_standard"
model_path = "/path/to/Qwen-Image-Layered"
default_steps = 50
default_cfg_scale = 4.0
default_resolution = 1024
layer_num = 4
cpu_offload = true

[models.qwenimageedit]
description = "Qwen-Image-Edit-2511 - instruction-based image editing (standalone)"
pipeline_class = "QwenImageEditPipeline"
text_encoder = "qwen2_5_vl_7b"
dit = "qwenimage_dit"
vae = "qwenimage_vae"
scheduler = "flow_standard"
# Qwen-Image-Edit is a standalone model, NOT related to Qwen-Image-Layered
model_path = ""  # Not used - edit_only mode loads directly from edit_model_path
edit_model_path = "/path/to/Qwen-Image-Edit-2511"
edit_only = true  # Load edit model directly, skip decompose pipeline
default_steps = 25
default_cfg_scale = 4.0
default_resolution = 640
cpu_offload = true

[models.qwenimage2512]
description = "Qwen-Image-2512 - text-to-image generation (pure t2i, no edit)"
pipeline_class = "QwenImage2512Pipeline"
text_encoder = "qwen2_5_vl_7b"
dit = "qwenimage2512_dit"
vae = "qwenimage_vae"
scheduler = "flow_standard"
model_path = "/path/to/Qwen-Image-2512"
default_steps = 40
default_cfg_scale = 4.0
default_resolution = 1024
cpu_offload = true
# FP8 required for 24GB GPUs - transformer is 39GB in bf16
quantize_transformer = "fp8"
quantize_text_encoder = "4bit"

# =============================================================================
# QUANTIZATION PRESETS
# Named combinations of component quantization settings
#
# VRAM Reference for Qwen-Image-Edit (20.43B DiT + 7B text encoder):
#   - DiT BF16: ~40GB | DiT FP8: ~20GB
#   - Text encoder BF16: ~14GB | 4bit: ~3.5GB
#
# With CPU offload, only DiT needs GPU VRAM. Text encoder runs on CPU.
# =============================================================================

[quantization.none]
description = "No quantization - full precision"
text_encoder = "none"
transformer = "none"

[quantization.balanced]
description = "Balanced VRAM reduction - 8bit encoder, no transformer quant"
text_encoder = "8bit"
transformer = "none"

[quantization.aggressive]
# For decompose pipeline (QwenImageLayeredPipeline), you MUST quantize
# BOTH text encoder AND transformer to fit in 24GB VRAM.
description = "Aggressive - 4bit encoder, 8bit transformer (required for decompose on 24GB)"
text_encoder = "4bit"
transformer = "8bit"

[quantization.dit_fp8_offload]
# RECOMMENDED for RTX 4090 with CPU offload:
# - DiT: FP8 on GPU (~20GB)
# - Text encoder: full precision on CPU (0 GPU VRAM)
# - VAE: full precision on CPU (0 GPU VRAM)
# Total GPU: ~20GB - plenty of headroom on 24GB!
description = "FP8 DiT on GPU, text encoder + VAE on CPU (recommended)"
text_encoder = "none"
transformer = "fp8"

[quantization.hybrid_fp8_4bit]
# Legacy: FP8 DiT + 4bit text encoder (for GPU-only inference without offload)
description = "Hybrid FP8 DiT + 4bit text encoder (GPU-only, no offload)"
text_encoder = "4bit"
transformer = "fp8"

[quantization.torchao_fp8]
description = "TorchAO FP8 quantization for both (RTX 4090+ only)"
text_encoder = "fp8"
transformer = "fp8"

[quantization.torchao_int8]
description = "TorchAO INT8 weight-only quantization"
text_encoder = "int8"
transformer = "int8"

# =============================================================================
# LAYER BLEND PRESETS (Experimental)
# Multi-layer blending combines embeddings from multiple hidden layers.
# Weights are normalized to sum to 1.0. Overrides default_hidden_layer when used.
# CLI usage: --layer-weights "-2:0.7,-6:0.3"
# =============================================================================

[layer_blend_presets.semantic]
description = "Penultimate + deeper semantic layer"
weights = {-2 = 0.7, -6 = 0.3}

[layer_blend_presets.balanced]
description = "Subtle blend of adjacent layers"
weights = {-2 = 0.6, -5 = 0.4}

[layer_blend_presets.deep]
description = "Add deeper conceptual features"
weights = {-2 = 0.7, -10 = 0.3}

[layer_blend_presets.middle]
description = "Middle layers + output"
weights = {-2 = 0.5, -19 = 0.5}

[layer_blend_presets.structure]
description = "Focus on structural layers"
weights = {-3 = 0.5, -8 = 0.5}

[layer_blend_presets.top3]
description = "Blend top 3 output layers"
weights = {-1 = 0.33, -2 = 0.34, -3 = 0.33}

# =============================================================================
# FEATURE CONFIGURATIONS
# Optional features that can be enabled per-config
# =============================================================================

[features.dype]
enabled = false
method = "vision_yarn"
dype_scale = 2.0
dype_exponent = 2.0
dype_start_sigma = 1.0
base_shift = 0.5
max_shift = 1.15
base_resolution = 1024
anisotropic = false

[features.slg]
enabled = false
scale = 2.5
layers = [7, 8, 9, 10, 11, 12]
start = 0.05
stop = 0.5

[features.fmtt]
enabled = false
guidance_scale = 1.0
guidance_start = 0.0
guidance_stop = 0.5
normalize_mode = "unit"
decode_scale = 0.5
siglip_model = "google/siglip2-giant-opt-patch16-384"
siglip_device = "cpu"

# =============================================================================
# COMBINED CONFIGURATIONS
# Pre-built combinations of profile + model + quantization + features
# =============================================================================

# --- Z-Image Configs ---

[configs.rtx4090_zimage]
description = "Z-Image on RTX 4090 - optimal performance"
profile = "rtx4090"
model = "zimage"
quantization = "balanced"
features = []

[configs.rtx4090_zimage_dype]
description = "Z-Image on RTX 4090 with DyPE for high-res"
profile = "rtx4090"
model = "zimage"
quantization = "balanced"
features = ["dype"]

[configs.rtx4090_zimage_slg]
description = "Z-Image on RTX 4090 with Skip Layer Guidance"
profile = "rtx4090"
model = "zimage"
quantization = "balanced"
features = ["slg"]

# --- Qwen-Image-Edit Configs ---

[configs.rtx4090_qwenimageedit_offload]
# RECOMMENDED for RTX 4090: FP8 DiT on GPU, text encoder on CPU
# Total GPU VRAM: ~20GB (DiT only)
description = "Qwen-Image-Edit with FP8 DiT + CPU offload (recommended)"
profile = "rtx4090"
model = "qwenimageedit"
quantization = "dit_fp8_offload"
features = []

[configs.rtx4090_qwenimageedit_compiled]
# BEST: FP8 DiT + CPU offload + torch.compile for ~2x speedup
# Total GPU VRAM: ~20GB
# First inference slower due to compilation (~10s cold start)
description = "Qwen-Image-Edit with FP8 DiT + CPU offload + torch.compile"
profile = "rtx4090"
model = "qwenimageedit"
quantization = "dit_fp8_offload"
features = []

[configs.rtx4090_qwenimageedit_compiled.overrides]
compile = true
compile_mode = "default"  # Only CPU-offload compatible mode (no CUDA graphs)

[configs.rtx4090_qwenimageedit_hybrid]
# Legacy: FP8 DiT + 4bit text encoder (GPU-only, no CPU offload)
description = "Qwen-Image-Edit with hybrid FP8+4bit (GPU-only)"
profile = "rtx4090"
model = "qwenimageedit"
quantization = "hybrid_fp8_4bit"
features = []

# --- Qwen-Image-Layered Configs ---

[configs.rtx4090_qwenlayered]
description = "Qwen-Image-Layered on RTX 4090"
profile = "rtx4090"
model = "qwenlayered"
quantization = "aggressive"  # Both components need quant for decompose
features = []

# --- Qwen-Image-2512 Configs ---
# Pure text-to-image generation (no edit functionality)
# Transformer is 39GB - requires FP8 quantization for 24GB GPUs

[configs.rtx4090_qwenimage2512]
# RECOMMENDED: FP8 transformer + 4bit text encoder + CPU offload
# Peak VRAM: ~20GB (transformer only on GPU at any time)
description = "Qwen-Image-2512 on RTX 4090 with FP8 + 4bit (recommended)"
profile = "rtx4090"
model = "qwenimage2512"
quantization = "hybrid_fp8_4bit"
features = []

[configs.rtx4090_qwenimage2512_offload]
# FP8 transformer on GPU, text encoder on CPU
# Use this if 4bit text encoder quality is not acceptable
description = "Qwen-Image-2512 with FP8 DiT + CPU offload for text encoder"
profile = "rtx4090"
model = "qwenimage2512"
quantization = "dit_fp8_offload"
features = []

# --- Default/Fallback Configs ---

[configs.default_zimage]
description = "Z-Image with auto device detection"
profile = "default"
model = "zimage"
quantization = "none"
features = []

[configs.cpu_zimage]
description = "Z-Image on CPU only (slow)"
profile = "cpu_only"
model = "zimage"
quantization = "none"
features = []

# --- Example with overrides ---

[configs.custom_example]
description = "Example with custom overrides"
profile = "rtx4090"
model = "zimage"
quantization = "balanced"
features = ["dype"]

[configs.custom_example.overrides]
steps = 12
width = 2048
height = 2048
compile = true

# =============================================================================
# SERVER SETTINGS
# =============================================================================

[server]
host = "127.0.0.1"
port = 7860
